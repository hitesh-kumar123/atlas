# Migration / admin connection — used ONLY by `prisma migrate` and the seed
# script. Never used to serve application requests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas"

# Application connection — the low-privilege `app_user` role created in
# prisma/migrations/0002_rls. This is what withTenant()/basePrisma actually
# use at request time. Set the real password to match what you set for
# app_user (the migration creates it with a placeholder password).
APP_DATABASE_URL="postgresql://app_user:change_me_in_env@localhost:5432/atlas"

AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"
