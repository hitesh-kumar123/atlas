generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  viewer
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  suspended   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  memberships Membership[]
  apiKeys     ApiKey[]
  events      Event[]
  invitations Invitation[]

  @@map("tenants")
}

// Users are global (one login can belong to many tenants via Membership).
// This is NOT a tenant-scoped table — RLS does not apply here directly,
// isolation happens through Membership + the session's active tenant.
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?
  name          String?
  createdAt     DateTime     @default(now())

  memberships   Membership[]
  invitedBy     Invitation[] @relation("InvitedBy")

  @@map("users")
}

// Join table — tenant-scoped. RLS applies.
model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(viewer)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

model Invitation {
  id         String   @id @default(cuid())
  tenantId   String
  email      String
  role       Role     @default(viewer)
  token      String   @unique
  invitedById String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

// Tenant-scoped. RLS applies. Key shown once at creation, only the hash persists.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  keyPrefix   String    // first 8 chars, shown in UI for identification (not secret)
  keyHash     String    // argon2 hash of the full key
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// Tenant-scoped. RLS applies. This is the biggest, hottest table — indexes matter.
// ADR-002: properties stored as JSONB rather than a separate EventProperty table.
// Reasoning: event schemas are arbitrary per-customer and change constantly; a
// normalized EventProperty table means an extra join on every funnel/retention
// query at 10M+ row scale, and those queries are exactly the ones with the 300ms
// budget. JSONB + a GIN index gets us flexible properties without the join, at
// the cost of losing per-property SQL type constraints (acceptable — validated
// by Zod at ingest instead, see lib/validation).
model Event {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  distinctId     String   // end-user identifier within the tenant's app
  properties     Json     @default("{}")
  idempotencyKey String?
  occurredAt     DateTime @default(now())
  receivedAt     DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, name, occurredAt])
  @@unique([tenantId, idempotencyKey])
  @@map("events")
}
